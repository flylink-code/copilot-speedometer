{
  "name": "copilot-speedometer",
  "displayName": "Copilot Speedometer",
  "description": "Status bar and dashboard showing tokens/second, latency and token usage for every GitHub Copilot Chat request, parsed from the local Copilot debug logs.",
  "version": "0.4.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flylink-code/copilot-speedometer.git"
  },
  "bugs": {
    "url": "https://github.com/flylink-code/copilot-speedometer/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "copilot",
    "tokens per second",
    "tok/s",
    "throughput",
    "latency",
    "ttft",
    "metrics",
    "status bar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotSpeedometer.showDashboard",
        "title": "%command.showDashboard.title%",
        "category": "Copilot Speedometer"
      },
      {
        "command": "copilotSpeedometer.refresh",
        "title": "%command.refresh.title%",
        "category": "Copilot Speedometer"
      },
      {
        "command": "copilotSpeedometer.enableLogging",
        "title": "%command.enableLogging.title%",
        "category": "Copilot Speedometer"
      },
      {
        "command": "copilotSpeedometer.exportJson",
        "title": "%command.exportJson.title%",
        "category": "Copilot Speedometer"
      },
      {
        "command": "copilotSpeedometer.clearHistory",
        "title": "%command.clearHistory.title%",
        "category": "Copilot Speedometer"
      },
      {
        "command": "copilotSpeedometer.seedDemo",
        "title": "%command.seedDemo.title%",
        "category": "Copilot Speedometer"
      },
      {
        "command": "copilotSpeedometer.diagnostics",
        "title": "%command.diagnostics.title%",
        "category": "Copilot Speedometer"
      }
    ],
    "configuration": {
      "title": "Copilot Speedometer",
      "properties": {
        "copilotSpeedometer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled.description%"
        },
        "copilotSpeedometer.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.description%"
        },
        "copilotSpeedometer.autoHideMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 1440,
          "description": "%config.autoHideMinutes.description%"
        },
        "copilotSpeedometer.statusBarFormat": {
          "type": "string",
          "enum": [
            "rate",
            "rate-model",
            "rate-ttft"
          ],
          "enumDescriptions": [
            "%config.statusBarFormat.rate%",
            "%config.statusBarFormat.rateModel%",
            "%config.statusBarFormat.rateTtft%"
          ],
          "default": "rate",
          "description": "%config.statusBarFormat.description%"
        },
        "copilotSpeedometer.logPath": {
          "type": "string",
          "default": "",
          "description": "%config.logPath.description%"
        },
        "copilotSpeedometer.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 60000,
          "description": "%config.pollIntervalMs.description%"
        },
        "copilotSpeedometer.historySize": {
          "type": "number",
          "default": 3000,
          "minimum": 100,
          "maximum": 50000,
          "description": "%config.historySize.description%"
        },
        "copilotSpeedometer.backfillDays": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 365,
          "description": "%config.backfillDays.description%"
        },
        "copilotSpeedometer.includeLegacyWorkspaceLogs": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeLegacyWorkspaceLogs.description%"
        },
        "copilotSpeedometer.usageEvents": {
          "type": "boolean",
          "default": true,
          "description": "%config.usageEvents.description%"
        },
        "copilotSpeedometer.usageEventsRoot": {
          "type": "string",
          "default": "",
          "description": "%config.usageEventsRoot.description%"
        }
      }
    }
  },
  "scripts": {
    "test": "node test/parser.test.js && node test/usage.test.js && node test/settings.test.js && node test/i18n.test.js",
    "preview": "node tools/preview.js",
    "package": "npx --yes @vscode/vsce@latest package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --out dist"
  },
  "icon": "media/icon.png"
}
