{
  "name": "copilot-speedometer",
  "displayName": "Copilot Speedometer",
  "description": "Status bar and dashboard showing tokens/second, latency and token usage for every GitHub Copilot Chat request, parsed from the local Copilot debug logs.",
  "version": "0.2.4",
  "publisher": "copilot-speedometer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flylink-code/copilot-speedometer.git"
  },
  "bugs": {
    "url": "https://github.com/flylink-code/copilot-speedometer/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "copilot",
    "tokens per second",
    "tok/s",
    "throughput",
    "latency",
    "ttft",
    "metrics",
    "status bar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilot-speedometer-container",
          "title": "Copilot Speedometer",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "copilot-speedometer-container": [
        {
          "type": "webview",
          "id": "copilotSpeedometer.sidebarView",
          "name": "%view.sidebar.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "copilotSpeedometer.showDashboard",
        "title": "%command.showDashboard.title%",
        "category": "Copilot Speedometer"
      },
      {
        "command": "copilotSpeedometer.openTab",
        "title": "%command.openTab.title%",
        "category": "Copilot Speedometer",
        "icon": "$(link-external)"
      },
      {
        "command": "copilotSpeedometer.refresh",
        "title": "%command.refresh.title%",
        "category": "Copilot Speedometer",
        "icon": "$(refresh)"
      },
      {
        "command": "copilotSpeedometer.enableLogging",
        "title": "%command.enableLogging.title%",
        "category": "Copilot Speedometer"
      },
      {
        "command": "copilotSpeedometer.exportJson",
        "title": "%command.exportJson.title%",
        "category": "Copilot Speedometer"
      },
      {
        "command": "copilotSpeedometer.clearHistory",
        "title": "%command.clearHistory.title%",
        "category": "Copilot Speedometer"
      },
      {
        "command": "copilotSpeedometer.seedDemo",
        "title": "%command.seedDemo.title%",
        "category": "Copilot Speedometer"
      },
      {
        "command": "copilotSpeedometer.diagnostics",
        "title": "%command.diagnostics.title%",
        "category": "Copilot Speedometer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "copilotSpeedometer.diagnostics",
          "when": "view == copilotSpeedometer.sidebarView",
          "group": "1_tools@1"
        },
        {
          "command": "copilotSpeedometer.exportJson",
          "when": "view == copilotSpeedometer.sidebarView",
          "group": "1_tools@2"
        },
        {
          "command": "copilotSpeedometer.clearHistory",
          "when": "view == copilotSpeedometer.sidebarView",
          "group": "2_danger@1"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Speedometer",
      "properties": {
        "copilotSpeedometer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled.description%"
        },
        "copilotSpeedometer.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.description%"
        },
        "copilotSpeedometer.autoHideMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 1440,
          "description": "%config.autoHideMinutes.description%"
        },
        "copilotSpeedometer.statusBarFormat": {
          "type": "string",
          "enum": [
            "rate",
            "rate-model",
            "rate-ttft"
          ],
          "enumDescriptions": [
            "%config.statusBarFormat.rate%",
            "%config.statusBarFormat.rateModel%",
            "%config.statusBarFormat.rateTtft%"
          ],
          "default": "rate",
          "description": "%config.statusBarFormat.description%"
        },
        "copilotSpeedometer.sessionScope": {
          "type": "string",
          "enum": [
            "window",
            "all"
          ],
          "enumDescriptions": [
            "%config.sessionScope.window%",
            "%config.sessionScope.all%"
          ],
          "default": "window",
          "description": "%config.sessionScope.description%"
        },
        "copilotSpeedometer.logPath": {
          "type": "string",
          "default": "",
          "description": "%config.logPath.description%"
        },
        "copilotSpeedometer.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 60000,
          "description": "%config.pollIntervalMs.description%"
        },
        "copilotSpeedometer.historySize": {
          "type": "number",
          "default": 3000,
          "minimum": 100,
          "maximum": 50000,
          "description": "%config.historySize.description%"
        },
        "copilotSpeedometer.backfillDays": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 365,
          "description": "%config.backfillDays.description%"
        },
        "copilotSpeedometer.includeLegacyWorkspaceLogs": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeLegacyWorkspaceLogs.description%"
        },
        "copilotSpeedometer.usageEvents": {
          "type": "boolean",
          "default": true,
          "description": "%config.usageEvents.description%"
        },
        "copilotSpeedometer.usageEventsRoot": {
          "type": "string",
          "default": "",
          "description": "%config.usageEventsRoot.description%"
        },
        "copilotSpeedometer.includeVscodeChats": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeVscodeChats.description%"
        },
        "copilotSpeedometer.pricingMultiplier": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.pricingMultiplier.description%"
        },
        "copilotSpeedometer.customPricing": {
          "type": "object",
          "default": {},
          "description": "%config.customPricing.description%"
        }
      }
    }
  },
  "scripts": {
    "test": "node test/parser.test.js && node test/usage.test.js && node test/scope.test.js && node test/pricing.test.js && node test/sessions.test.js && node test/settings.test.js && node test/i18n.test.js",
    "preview": "node tools/preview.js",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npx --yes @vscode/vsce@latest package --no-dependencies --allow-missing-repository --out dist"
  },
  "icon": "media/icon.png"
}
